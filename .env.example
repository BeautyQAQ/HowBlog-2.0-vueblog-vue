# Use .env.local (already ignored); pass --env-file .env.local to Docker Compose.
# Bind to loopback for a trusted HTTPS reverse proxy on the same host.
HOW_WEB_BIND_ADDRESS=127.0.0.1
HOW_WEB_PORT=8080
HOW_WEB_IMAGE=howblog-web:local

# Trusted private HTTP origin only: http://host:port, with no path or trailing slash.
# Public HTTPS/WSS must terminate at the trusted outer reverse proxy.
# Defaults reach the backend's published host ports from the frontend container.
HOW_BASE_UPSTREAM=http://host.docker.internal:9001
HOW_ARTICLE_UPSTREAM=http://host.docker.internal:9004
HOW_USER_UPSTREAM=http://host.docker.internal:9008

# Only for docker/compose.backend-network.yml; use the actual existing network name.
HOW_BACKEND_NETWORK=
